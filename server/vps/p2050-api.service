# systemd service for the Project : 2050 API (Node.js). Copy to /etc/systemd/system/p2050-api.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now p2050-api
# Logs: journalctl -u p2050-api -f
[Unit]
Description=Project 2050 game API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=p2050
WorkingDirectory=/opt/project2050/server/api
EnvironmentFile=/opt/project2050/server/.env
Environment=NODE_ENV=production PORT=3000 HOST=127.0.0.1 TZ=Asia/Bangkok CERT_CONFIG=/opt/project2050/server/certificate/certificate.json
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
