{
  "name": "p2050-api",
  "version": "1.7.0",
  "description": "Project Zero game server: accounts, Terra, shop, leaderboard, cloud saves, certificates",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "make-admin": "node scripts/make-admin.js",
    "reset-password": "node scripts/reset-password.js",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio --port 5555 --browser none",
    "db:new": "prisma migrate dev --create-only --name"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^10.3.0",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.7",
    "google-auth-library": "^9.15.1",
    "jose": "^5.10.0",
    "pdfkit": "^0.15.2",
    "pg": "^8.23.1",
    "prisma": "7.10.0",
    "qrcode": "1.5.4"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
