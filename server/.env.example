# Copy this file to .env, then change the passwords and the secret.
# Use only letters and numbers in POSTGRES_PASSWORD (it goes into a URL).

# port on this computer/server where the game opens: http://localhost:8080
WEB_PORT=8080

POSTGRES_DB=p2050
POSTGRES_USER=p2050
POSTGRES_PASSWORD=changeMeDbPassword123

# VPS without Docker only: how the API reaches PostgreSQL (Docker builds this line itself from the three above)
# DATABASE_URL=postgres://p2050:changeMeDbPassword123@localhost:5432/p2050

# a long random string (32+ characters); keep it secret. Changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string-0123456789abcdef

# Google Sign-In: paste the OAuth "Client ID" from Google Cloud Console (leave empty to hide the Google button)
GOOGLE_CLIENT_ID=

# who may call the API from a browser (* = anyone; or e.g. https://p2050.example.com)
CORS_ORIGIN=*

# the public address of the game, used in certificate links (e.g. https://p2050.example.com). Empty = from the request.
PUBLIC_URL=

# certificate: knowledge cards needed (plus at least one Net Zero win)
CERT_MIN_CARDS=20

# games shorter than this (seconds of real time) earn no Terra
MIN_GAME_SECONDS=300
