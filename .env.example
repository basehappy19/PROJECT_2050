# Project Zero · settings for `npm run build` and `npm start` (copy to .env and edit).
# Docker users: use server/.env instead (see server/README.md).

# ---------- ports (each service can be put behind your own Nginx) ----------
# the game + the admin page (/admin) + /api and /verify forwarded to the API → one port is enough for a reverse proxy
WEB_PORT=8080
# the API on its own (Nginx can also send /api and /verify here directly)
API_PORT=3000
# optional: serve the admin page on its own port as well (empty = only at WEB_PORT/admin/)
ADMIN_PORT=
# Prisma Studio (`npm run studio`), always on 127.0.0.1 only
STUDIO_PORT=5555
# address the services listen on: 127.0.0.1 = only this machine (behind Nginx), 0.0.0.0 = every network
HOST=127.0.0.1

# ---------- public address ----------
# the address players open, used in certificate links and to lock CORS (e.g. https://game.example.ac.th)
PUBLIC_URL=
# `npm run build` locks the game to these domains (comma separated, leading dot = any sub-domain); empty = no lock
GAME_DOMAINS=
# who may call the API from a browser (empty = PUBLIC_URL, * = anyone)
CORS_ORIGIN=

# ---------- database (PostgreSQL) ----------
DATABASE_URL=postgres://p2050:change-me@localhost:5432/p2050

# ---------- API ----------
# a long random string (32+ characters): `openssl rand -hex 32`. Changing it signs everyone out.
JWT_SECRET=
# Google Sign-In OAuth client id (empty = no Google button)
GOOGLE_CLIENT_ID=
# certificate: knowledge cards needed (plus at least one Net Zero win)
CERT_MIN_CARDS=20
# games shorter than this (seconds of real time) earn no gems
MIN_GAME_SECONDS=300
